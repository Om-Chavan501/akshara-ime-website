---
import Base from "../layouts/Base.astro";
import Account from "../components/Account.tsx";
---
<Base title="Your account — AksharaIME" noindex={true}>
  <div class="wrap section acct-page">
    {/* client:only — this page is entirely session-dependent, so server-rendering it would
        flash a signed-out state before hydration corrects it. */}
    <Account client:only="react" />
  </div>
</Base>

<style is:global>
  .acct-page { max-width: 640px; }

  .acct h1 { margin-bottom: var(--space-3); }
  .acct-lede { margin-bottom: var(--space-8); }

  .acct-head {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: var(--space-4); margin-bottom: var(--space-8); flex-wrap: wrap;
  }

  .acct-card {
    background: var(--bg-raised); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: var(--space-6); margin-bottom: var(--space-4);
  }
  .acct-card h2 { font-size: var(--text-lg); margin-bottom: var(--space-2); }

  .acct label {
    display: block; font-size: var(--text-sm); font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .acct input {
    width: 100%; padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-strong); border-radius: var(--radius);
    background: var(--bg); color: var(--text);
    font: inherit; font-size: var(--text-base);
    min-height: 46px;   /* ≥44px touch target, and stops iOS zooming on focus */
  }
  .acct input:focus-visible { border-color: var(--accent); }
  .acct .hint { font-size: var(--text-sm); color: var(--text-muted); margin: var(--space-2) 0 var(--space-4); }

  .btn.full { width: 100%; }
  .btn-google { width: 100%; }
  .btn-sm { min-height: 38px; padding: calc(var(--space-2) + 2px) var(--space-4) calc(var(--space-2) - 2px); font-size: var(--text-sm); }
  .danger-btn { background: var(--danger); color: #fff; }

  .divider {
    display: flex; align-items: center; gap: var(--space-4);
    margin: var(--space-6) 0; color: var(--text-subtle); font-size: var(--text-sm);
  }
  .divider::before, .divider::after {
    content: ""; flex: 1; height: 1px; background: var(--border);
  }

  .row-actions {
    display: flex; justify-content: space-between; gap: var(--space-4);
    margin-top: var(--space-4); flex-wrap: wrap;
  }
  .linkish {
    background: none; border: none; padding: var(--space-2) 0; font: inherit;
    font-size: var(--text-sm); color: var(--text-muted);
    text-decoration: underline; cursor: pointer; min-height: 44px;
  }
  .linkish:hover:not(:disabled) { color: var(--text); }
  .linkish:disabled { opacity: .5; cursor: not-allowed; text-decoration: none; }

  .tierlist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .tierbtn {
    width: 100%; display: flex; justify-content: space-between; align-items: baseline;
    gap: var(--space-4); padding: var(--space-4);
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); font: inherit; color: var(--text);
    cursor: pointer; min-height: 56px; text-align: left;
    transition: border-color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }
  .tierbtn:hover { border-color: var(--accent); background: var(--accent-subtle); }
  .tierbtn:active { transform: scale(0.99); }
  .tierprice strong { font-size: var(--text-lg); }

  .lic-head { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); flex-wrap: wrap; }
  .pill {
    display: inline-block; font-size: var(--text-xs); font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
    background: var(--accent-subtle); color: var(--accent);
    padding: 2px 9px; border-radius: var(--radius-full); margin-bottom: var(--space-2);
  }
  .slots { font-size: var(--text-sm); color: var(--text-muted); }

  .sec-title { font-size: var(--text-lg); margin: var(--space-8) 0 var(--space-4); }

  .devlist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .dev {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    background: var(--bg-raised); border: 1px solid var(--border);
    border-radius: var(--radius); padding: var(--space-4); flex-wrap: wrap;
  }
  .dev-main { display: flex; gap: var(--space-3); align-items: flex-start; }
  .dev-state { margin-top: 2px; }
  /* Shape as well as colour would be better still, but the state is always spelled out in
     text beside it — colour is never the only signal. */
  .dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 8px; flex: none; }
  .dot.on { background: var(--success); }
  .dot.off { background: var(--text-subtle); }
  .dev-actions { display: flex; gap: var(--space-2); }

  .upgrade-row { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .empty { text-align: center; }

  .feedback { margin-top: var(--space-6); }
  .msg { padding: var(--space-3) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); }
  .msg.err { background: var(--danger-bg); color: var(--danger); }
  .msg.ok { background: var(--accent-subtle); color: var(--accent); }

  /* Skeleton rather than a spinner: it reserves the space the content will occupy, so
     nothing jumps when it arrives. */
  .acct-skeleton {
    height: 220px; border-radius: var(--radius-lg);
    background: linear-gradient(90deg, var(--bg-sunken) 25%, var(--bg-raised) 50%, var(--bg-sunken) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite linear;
  }
  @keyframes shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .acct-skeleton { animation: none; background: var(--bg-sunken); }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
