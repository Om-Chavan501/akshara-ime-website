---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import ImeExplainer from "../components/ImeExplainer.tsx";
import TryIt from "../components/TryIt.tsx";
import HeroDemo from "../components/HeroDemo.tsx";
import Reveal from "../components/Reveal.astro";
import Comparison from "../components/Comparison.tsx";

// Served from our own domain. The deploy workflow pulls the released .pkg into
// public/download/ (scripts/fetch-installer.mjs), picking the version from appcast.json --
// the same file installed copies poll -- so the site cannot offer a different build from the
// one it tells them to fetch. Same-origin also means the `download` attribute works, instead
// of being ignored cross-origin and leaving a blank tab behind.
const DOWNLOAD_URL = "/download/AksharaIME-Installer.pkg";

// One table, shared with the account page. Two copies is how the USD figures went stale
// here while the account page and Paddle had moved on.
import { TIERS as tiers, PRICE_IDS, SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase";

const examples = [
  { typed: "namaskaara", got: "नमस्कार" },
  { typed: "jhaalM",     got: "झालं" },
  { typed: "maraaThI",   got: "मराठी" },
  { typed: "puNe",       got: "पुणे" },
];
---

<Base title="AksharaIME — Marathi typing for Mac">

  <!-- ================= Hero ================= -->
  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">macOS input method</p>
        <h1>Type Marathi the way you already say it.</h1>
        <p class="lede hero-lede">
          Spell it how it sounds and watch it become Devanagari — in any app on your Mac,
          with no new keyboard layout to learn.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/account.html">Get AksharaIME</a>
          <a class="btn btn-ghost" href="#try">Try it first</a>
        </div>
        <p class="small muted hero-note">
          One-time purchase · macOS 13+ · Apple Silicon and Intel · Early access
        </p>
      </div>
      <div class="hero-visual">
        <HeroDemo client:load />
      </div>
    </div>
  </section>

  <!-- ================= Try it =================
       Placed immediately after the hero on purpose: the recommended pattern for this
       product type is "Interactive Demo + Feature-Rich", and the demo IS the argument. -->
  <section class="bleed bleed-accent" id="try">
    <div class="wrap section">
    <Reveal>
      <p class="eyebrow">Try it right now</p>
      <h2 class="try-title">Type something. Watch it convert.</h2>
      <p class="lede try-lede">
        This is the real conversion engine — not a demo of one. The same rules, the same code
        the app runs. Type anything and see whether it gets your words right.
      </p>
    </Reveal>
    <TryIt client:visible />
    </div>
  </section>

  <!-- ================= What you type → what you get ================= -->
  <section class="wrap section" id="how">
    <Reveal>
      <p class="eyebrow">How it works</p>
      <h2>Phonetic, not positional.</h2>
    </Reveal>
    <p class="lede" style="margin-bottom: var(--space-12);">
      You spell words how they sound in Roman letters. AksharaIME converts them as you type,
      and commits when you press space — the same scheme people have used on Windows for
      twenty years, now done properly on the Mac.
    </p>

    <ul class="examples">
      {examples.map(({ typed, got }, i) => (
        <Reveal as="li" index={i} class="example">
          <code>{typed}</code>
          <span class="arrow" aria-hidden="true">→</span>
          <span class="deva result" lang="mr">{got}</span>
        </Reveal>
      ))}
    </ul>
  </section>

  <!-- ================= IME explainer ================= -->
  <section class="wrap section explainer-section">
    <ImeExplainer client:visible />
  </section>

  <!-- ================= Why: the comparison =================
       The vaa~gmaya example is the strongest argument on the page — a real word that
       suggestion-based transliteration reliably gets wrong. -->
  <section class="bleed bleed-sunken">
    <div class="wrap section">
      <Reveal>
        <p class="eyebrow">Why not the built-in options</p>
        <h2>One word, three approaches.</h2>
        <p class="lede section-lede">
          <span lang="mr">वाङ्मय</span> — a perfectly ordinary Marathi word with a conjunct in
          the middle. Here's
          what each way of typing it actually gives you.
        </p>
      </Reveal>
      <Comparison />
    </div>
  </section>

  <!-- ================= Pricing ================= -->
  <section class="bleed" id="pricing">
    <div class="wrap section">
    <Reveal>
      <p class="eyebrow">Pricing</p>
      <h2>Buy once. It stays yours.</h2>
    </Reveal>
    <p class="lede" style="margin-bottom: var(--space-8);">
      No subscription. Pay for the number of Macs you want to use it on, and add more later
      if you need to.
    </p>

    <div class="pricing-grid">
      {tiers.map(({ devices, inr, usd }, i) => (
        <Reveal index={i} class={`tier-card${devices === 2 ? " is-popular" : ""}`}>
          <a href="/account.html" class="tier-link">
            {devices === 2 && <span class="tier-badge">Laptop + desktop</span>}
            <span class="tier-count">{devices} {devices === 1 ? "Mac" : "Macs"}</span>
            <span class="tier-price" data-price-id={PRICE_IDS[devices]}>{inr}</span>
            <span class="tier-usd muted small">or {usd}</span>
          </a>
        </Reveal>
      ))}
    </div>

    {/* Replaces the rendered prices with what this visitor will actually be charged.

        Paddle is configured with a USD base and an India-only INR override, so a visitor in
        the US was being shown rupees prominently and then charged dollars — the page and the
        checkout disagreeing, which is the one thing a pricing table must never do. Hardcoding
        guarantees that drift: these figures said $17.99 for a while after Paddle had moved to
        $29.

        Progressive enhancement on purpose. The prices above are real, server-rendered and
        correct for India, so a failed fetch or no JavaScript leaves a working pricing table
        rather than an empty one — the same rule as the reveals. */}
    <script is:inline define:vars={{ endpoint: `${SUPABASE_URL}/functions/v1/price-preview`, anon: SUPABASE_ANON_KEY }}>
      fetch(endpoint, {
        method: "POST",
        headers: { apikey: anon, Authorization: "Bearer " + anon, "Content-Type": "application/json" },
        body: "{}",
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.items) return;
          var localised = false;
          data.items.forEach(function (item) {
            var el = document.querySelector('[data-price-id="' + item.price_id + '"]');
            if (!el || !item.total) return;
            el.textContent = item.total;
            localised = true;
          });
          // The "or $X" line is a second currency for people who aren't being quoted it. Once
          // the real one is shown, it is just noise — and for a visitor outside India it was
          // actively misleading, since the rupee figure was never going to be charged.
          if (localised) {
            document.querySelectorAll(".tier-usd").forEach(function (el) { el.remove(); });
          }
        })
        .catch(function () { /* keep the server-rendered prices */ });
    </script>

    <p class="small muted pricing-note">
      In India the price includes GST; elsewhere any local sales tax is added at checkout.
      You'll create an account before paying, so your licence is attached
      to an address you've confirmed — no lost purchases from a mistyped email. Need more
      later? Buy a bigger tier and we raise your existing licence rather than starting a new one.
      This is an early-access build and it isn't notarised by Apple yet, so installing takes
      one extra step — said here rather than left for you to find in the Terms afterwards.
      If it isn't for you, the 14-day refund is no-questions.
    </p>
    </div>
  </section>

  <!-- ================= Install ================= -->
  <section class="wrap section" id="install">
    <Reveal>
      <p class="eyebrow">Installing</p>
      <h2>Five minutes, one restart.</h2>
    </Reveal>
    <p class="lede" style="margin-bottom: var(--space-12);">
      Being honest about the awkward parts: macOS requires a login cycle before it will
      recognise a new input method, and AksharaIME isn't notarised by Apple yet, so you'll
      see a security warning. Both are one-time.
    </p>

    {/* The download sits above the steps rather than in the nav or the hero: someone who
        hasn't bought yet has no use for it, and someone who has is following these steps.
        Deliberately not gated — the asset is a public GitHub Releases URL, so a sign-in wall
        would protect nothing while still stranding a customer reinstalling on a new Mac. */}
    <div class="download">
      <a class="btn btn-primary" href={DOWNLOAD_URL} download>
        Download for macOS
      </a>
      <p class="small muted download-note">
        Free to download · a licence is needed to type in Marathi ·
        macOS 13+ · Apple Silicon and Intel
      </p>
    </div>

    <ol class="steps">
      <li>
        <div>
        <h3>Run the installer</h3>
        <p class="muted small">
          macOS will say it can't verify the developer. Click <strong>Done</strong>, then open
          <strong>System Settings → Privacy &amp; Security</strong>, scroll down, and click
          <strong>Open Anyway</strong>.
        </p>
        </div>
      </li>
      <li>
        <div>
        <h3>Log out and back in</h3>
        <p class="muted small">
          Or restart. macOS only picks up newly installed input methods after a login cycle —
          skip this and it simply won't appear.
        </p>
        </div>
      </li>
      <li>
        <div>
        <h3>Add the input source</h3>
        <p class="muted small">
          <strong>System Settings → Keyboard → Input Sources → +</strong>, then find
          <strong>AksharaIME</strong>. It's listed under English.
        </p>
        </div>
      </li>
      <li>
        <div>
        <h3>Sign in and activate</h3>
        <p class="muted small">
          Open AksharaIME Companion, sign in, and click <strong>Activate this Mac</strong>.
        </p>
        </div>
      </li>
      <li>
        <div>
        <h3>Start typing</h3>
        <p class="muted small">
          Switch to AksharaIME in the menu bar and type <code>namaskaara</code>.
        </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- ================= Requirements + FAQ ================= -->
  <section class="wrap section" id="faq">
    <p class="eyebrow">Details</p>
    <h2>The specifics.</h2>

    <div class="faq">
      <details open>
        <summary>What do I need to run it?</summary>
        <p class="muted">
          <strong>macOS 13 (Ventura) or later</strong>, on either Apple Silicon or Intel.
          It's a universal build, so it runs natively on both.
        </p>
      </details>
      <details>
        <summary>Does it work in every app?</summary>
        <p class="muted">
          It's a system input method, so it works anywhere you can type — Pages, Word, Mail,
          Safari, Slack, your terminal. Nothing app-specific.
        </p>
      </details>
      <details>
        <summary>Does my typing go anywhere?</summary>
        <p class="muted">
          No. Conversion happens entirely on your Mac. The app checks your licence with our
          server periodically, and that check sends a hashed device identifier and nothing
          else — no keystrokes, no text, no app names.
        </p>
      </details>
      <details>
        <summary>What if I get a new Mac?</summary>
        <p class="muted">
          Deactivate the old one and activate the new one. If the old Mac is online it hands
          over immediately; if it's lost or dead you can release its slot yourself.
        </p>
      </details>
      <details>
        <summary>Can I get a refund?</summary>
        <p class="muted">
          Yes — within 14 days, no questions asked. Email us and we'll sort it out.
        </p>
      </details>
    </div>
  </section>

</Base>

<style>
  .hero { padding-block: var(--space-16) var(--space-16); }
  .hero-grid { display: grid; gap: var(--space-12); align-items: center; }
  .hero h1 {
    font-size: clamp(2.1rem, 7vw, var(--text-4xl));
    margin-bottom: var(--space-4);
    max-width: 15ch;          /* forces a deliberate 2–3 line break instead of one long line */
  }
  .hero-lede { margin-bottom: var(--space-8); max-width: 44ch; }
  .hero-cta { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .hero-note { margin-top: var(--space-6); }

  @media (min-width: 900px) {
    .hero { padding-block: var(--space-24) var(--space-24); }
    /* Asymmetric on purpose: copy leads, the demo supports. Two equal columns would read as
       two competing focal points. */
    .hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: var(--space-16); }
  }

  .examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .example {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
  }
  .example .arrow { color: var(--text-subtle); }
  .example .result { font-size: var(--text-xl); color: var(--accent); }

  .explainer-section {
    border-block: 1px solid var(--border);
    background: var(--bg-sunken);
  }

  .grid3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .pricing-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 900px) {
    .pricing-grid { grid-template-columns: repeat(5, 1fr); }
  }

  /* The positioning context for .tier-badge lives HERE, on the link, not on .tier-card.
     .tier-card is the Reveal island's wrapper — created by React on the client, so it never
     receives Astro's scoping attribute and no scoped rule can reach it. `position: relative`
     sat there doing nothing, the badge fell back to a containing block far up the page, and
     it floated near the top of the section. It looked correct on hover purely by accident:
     .tier-link's hover `transform` creates a containing block, so hovering snapped it into
     the right place. Same island-scoping trap as NavAccount — scoped CSS reaches an island's
     server-rendered children, never its client-created wrapper. */
  .tier-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    text-decoration: none;
    color: var(--text);
    height: 100%;
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }
  .tier-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    color: var(--text);
  }
  .tier-link:active { transform: translateY(0) scale(0.98); }

  /* The 2-device tier carries visual weight so the grid offers a default, rather than five
     identical boxes with no signal about which to pick. The badge says who the tier suits
     ("Laptop + desktop") rather than claiming other people bought it: with one sale on the
     books, any "most customers choose this" is invented social proof. Revisit the wording
     when the orders table can actually support it. */
  .is-popular .tier-link {
    border-color: var(--accent);
    border-width: 2px;
    background: var(--accent-subtle);
  }
  .tier-badge {
    position: absolute;
    top: -11px;
    /* Explicit rather than relying on the flex static position, so centring doesn't depend
       on how a browser resolves the static position of an abspos flex child. */
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--text-on-accent);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }
  .tier-count { font-size: var(--text-sm); color: var(--text-muted); margin-top: var(--space-2); }
  .tier-price { font-size: var(--text-xl); font-weight: 700; }
  .tier-usd { margin-top: -2px; }

  .pricing-note { margin-top: var(--space-8); max-width: 60ch; }

  /* The download sits between the lede and the numbered steps, so it reads as step zero
     without being numbered — it isn't something you do on your Mac, it's how you get there. */
  .download {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
    margin-bottom: var(--space-12);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .download-note { margin: 0; max-width: 46ch; }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
    max-width: 62ch;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .steps li::before {
    content: counter(step);
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    background: var(--accent-subtle);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .steps h3 { margin-bottom: var(--space-1); }

  .faq { max-width: 68ch; }
  .faq details {
    border-bottom: 1px solid var(--border);
    padding: var(--space-4) 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+";
    color: var(--text-subtle);
    font-weight: 400;
  }
  .faq details[open] summary::after { content: "−"; }
  .faq details p { margin-top: var(--space-3); }

  .try-section { border-block: 1px solid var(--border); background: var(--bg-sunken); }
  .try-title { margin-bottom: var(--space-4); }
    .try-lede { margin-bottom: var(--space-12); max-width: 54ch; }
  .section-lede { margin-bottom: var(--space-12); max-width: 56ch; }
  .center { text-align: center; }
</style>
